  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single commit action on a page — a form submit or a promo CTA.",
      "html": "<button class=\"ds-btn-primary\">Pošalji poruku</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 24px;border:0;border-radius:8px;background:var(--color-brand-accent);color:var(--color-brand-on-accent);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;font-weight:500;cursor:pointer;transition:opacity 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-btn-primary:hover{opacity:0.9}\n.ds-btn-primary:disabled{opacity:0.5;cursor:not-allowed}\n.ds-btn-primary:focus-visible{outline:2px solid var(--color-brand-accent);outline-offset:2px;border-radius:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action: outlined, quiet at rest, bronze on hover.",
      "html": "<button class=\"ds-btn-ghost\">Vidi sve</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;gap:8px;padding:14px 24px;border:1px solid var(--color-brand-border);border-radius:8px;background:transparent;color:var(--color-brand-dim);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;font-weight:500;cursor:pointer;transition:color 150ms cubic-bezier(0.4,0,0.2,1),border-color 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-btn-ghost:hover{border-color:var(--color-brand-accent);color:var(--color-brand-accent)}\n.ds-btn-ghost:focus-visible{outline:2px solid var(--color-brand-accent);outline-offset:2px;border-radius:3px}"
    },
    {
      "name": "Tag Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Tags, hero topic pills, search filters and the article meta row. Never filled at rest.",
      "html": "<a class=\"ds-chip\"># hadis <span class=\"ds-chip-n\">309 REČI</span></a>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border:1px solid var(--color-brand-border);border-radius:9999px;background:var(--color-brand-surface);color:var(--color-brand-dim);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;transition:color 150ms cubic-bezier(0.4,0,0.2,1),border-color 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-chip:hover{border-color:var(--color-brand-accent);color:var(--color-brand-accent)}\n.ds-chip-n{color:var(--color-brand-dim);opacity:.8}\n.ds-chip:focus-visible{outline:2px solid var(--color-brand-accent);outline-offset:2px;border-radius:3px}"
    },
    {
      "name": "Article Card",
      "kind": "card",
      "refersTo": "card",
      "description": "A listing entry: serif title, mono metadata, tag chips. Flat — the border does the framing.",
      "html": "<a class=\"ds-card\">\n  <span class=\"ds-card-meta\">ATEIZAM · 6. AVGUST 2026. · 2 MIN ČITANJA</span>\n  <h3 class=\"ds-card-title\">Da li je Allah bog Meseca?</h3>\n  <p class=\"ds-card-excerpt\">Ime Allah nema paganskog porekla. Hiljade arapskih hrišćana i pre islama obožavale su jednog Boga.</p>\n  <span class=\"ds-card-tags\"><span class=\"ds-chip\"># biblija</span></span>\n</a>",
      "css": ".ds-card{display:block;padding:24px;border:1px solid var(--color-brand-border);border-radius:8px;background:var(--color-brand-surface);text-decoration:none;transition:border-color 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-card:hover{border-color:var(--color-brand-border-strong)}\n.ds-card-meta{display:block;margin-bottom:12px;color:var(--color-brand-dim);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;letter-spacing:0.1em;text-transform:uppercase}\n.ds-card-title{margin:0 0 8px;font-family:var(--font-serif);font-size:24px;font-weight:500;line-height:1.25;color:var(--color-brand-heading);transition:color 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-card:hover .ds-card-title{color:var(--color-brand-accent)}\n.ds-card-excerpt{margin:0 0 16px;font-family:var(--font-sans);font-size:14px;line-height:1.6;color:var(--color-brand-dim);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}\n.ds-card-tags{display:flex;flex-wrap:wrap;gap:8px}\n.ds-card:focus-visible{outline:2px solid var(--color-brand-accent);outline-offset:2px;border-radius:3px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Every form field on the site. The border turns bronze on focus; the global ring follows.",
      "html": "<input class=\"ds-input\" type=\"email\" placeholder=\"vasa@email.adresa\" />",
      "css": ".ds-input{width:100%;box-sizing:border-box;padding:12px 16px;border:1px solid var(--color-brand-border);border-radius:8px;background:var(--color-brand-surface);color:var(--color-brand-heading);font-family:var(--font-sans);font-size:14px;transition:border-color 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-input::placeholder{color:var(--color-brand-dim)}\n.ds-input:focus{border-color:var(--color-brand-accent)}\n.ds-input:focus-visible{outline:2px solid var(--color-brand-accent);outline-offset:2px;border-radius:3px}"
    },
    {
      "name": "Nav Link",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Fixed 64px bar, serif wordmark, uppercase mono links that turn bronze on hover and current.",
      "html": "<nav class=\"ds-nav\">\n  <a class=\"ds-nav-mark\">ADAM</a>\n  <a class=\"ds-nav-link\" aria-current=\"page\">Kategorije</a>\n  <a class=\"ds-nav-link\">Tagovi</a>\n</nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:24px;height:64px;padding:0 24px;border-bottom:1px solid var(--color-brand-border);background:var(--color-brand-bg)}\n.ds-nav-mark{font-family:var(--font-serif);font-size:24px;font-weight:500;color:var(--color-brand-heading);text-decoration:none}\n.ds-nav-link{color:var(--color-brand-dim);text-decoration:none;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;transition:color 150ms cubic-bezier(0.4,0,0.2,1)}\n.ds-nav-link:hover,.ds-nav-link[aria-current=\"page\"]{color:var(--color-brand-accent)}\n.ds-nav-mark:focus-visible{outline:2px solid var(--color-brand-accent);outline-offset:2px;border-radius:3px}\n.ds-nav-link:focus-visible{outline:2px solid var(--color-brand-accent);outline-offset:2px;border-radius:3px}"
    },
    {
      "name": "MDX Callout (Scholar)",
      "kind": "custom",
      "refersTo": "callout",
      "description": "Unfilled marginal note with a 4px side rule in a semantic ink. Six tones ship: note, info, warn, scholar, quran, bible.",
      "html": "<div class=\"ds-callout\">\n  <div class=\"ds-callout-head\">\n    <svg class=\"ds-callout-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n      <path d=\"M15 12h-5\"/><path d=\"M15 8h-5\"/><path d=\"M19 17V5a2 2 0 0 0-2-2H4\"/>\n      <path d=\"M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3\"/>\n    </svg>\n    <span>dr Albert van den Branden</span>\n  </div>\n  <p>Malo je verovatno da je poslanik Muhammed ime Allah pozajmio iz paganskog sveta.</p>\n</div>",
      "css": ".ds-callout{border-left:4px solid var(--color-brand-scholar-fg);padding:16px 20px;background:transparent}\n.ds-callout-head{display:flex;align-items:center;gap:8px;margin-bottom:8px;color:var(--color-brand-scholar-fg);font-family:var(--font-sans);font-size:14px;font-weight:600;letter-spacing:0.025em}\n.ds-callout-icon{width:20px;height:20px;flex-shrink:0}\n.ds-callout p{margin:0;font-family:var(--font-sans);font-size:17.6px;line-height:1.7;color:var(--color-brand-text)}"
    },
    {
      "name": "Table of Contents Item",
      "kind": "custom",
      "refersTo": "toc-item",
      "description": "One row of the outline, rendered identically in the desktop margin column and the mobile sheet. Arabic-Indic numbering.",
      "html": "<div class=\"ds-toc\">\n  <button class=\"ds-toc-item is-active\" aria-current=\"location\"><span class=\"ds-toc-n\">١</span><span>Optužba</span></button>\n  <button class=\"ds-toc-item\"><span class=\"ds-toc-n\">٢</span><span>Ime Allah nema pagansko poreklo</span></button>\n  <button class=\"ds-toc-item is-sub\"><span class=\"ds-toc-d\"></span><span>Egipatsko božanstvo Meseca Jah</span></button>\n</div>",
      "css": ".ds-toc{padding:16px;border-top:1px solid var(--color-brand-muted);border-bottom:1px solid var(--color-brand-muted);background:var(--color-brand-bg)}\n.ds-toc-item{display:flex;align-items:center;gap:12px;width:100%;min-height:44px;padding:6px 12px;border:0;border-radius:8px;background:transparent;color:var(--color-brand-text);font-family:var(--font-sans);font-size:12px;line-height:1.375;text-align:left;cursor:pointer;transition:color 150ms cubic-bezier(0.4,0,0.2,1),background-color 150ms cubic-bezier(0.4,0,0.2,1),transform 200ms cubic-bezier(0.4,0,0.2,1)}\n.ds-toc-item:hover{transform:translateX(3px)}\n.ds-toc-item.is-active{background:var(--color-brand-muted);color:var(--color-brand-accent)}\n.ds-toc-n{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;flex-shrink:0;border:1px solid var(--color-brand-dim);border-radius:6px;font-size:11px;font-weight:500}\n.ds-toc-item.is-active .ds-toc-n{border-color:var(--color-brand-accent);background:color-mix(in srgb,var(--color-brand-accent) 10%,transparent);color:var(--color-brand-accent)}\n.ds-toc-item.is-sub{padding-left:32px}\n.ds-toc-d{width:6px;height:6px;flex-shrink:0;background:var(--color-brand-dim);transform:rotate(45deg)}\n.ds-toc-item.is-sub.is-active .ds-toc-d,.ds-toc-item.is-sub:hover .ds-toc-d{background:var(--color-brand-accent)}\n.ds-toc-item:focus-visible{outline:2px solid var(--color-brand-accent);outline-offset:2px;border-radius:3px}"
    }
  ],
  "narrative": {
    "northStar": "The Annotated Manuscript",
    "overview": "Every surface in this system is a page of a working codex. Headings carry a mono marginalia label above them, the way a scribe's rubric sits above the passage it names; sections are marked with a small bronze diamond rotated 45°, standing in for the rubrication marks of a manuscript; the article body is set in a single 65-character measure with a numbered table of contents hanging beside it in the margin. The two themes are the two states of that page: Lampblack (#11100d) is the reading room after dark, Uncoated Cream (#f5f1e8) is the sheet itself, carrying a 5%-opacity fractal grain that is applied as a fixed overlay and never in dark mode.\n\nPersonality: formal, calm and unhurried. Authority comes from the serif headings, the whitespace and the typographic scale — never from colour, effects or ornament. Content density is that of a reference archive: long articles, source citations, tables of isnad chains, and a metadata row on every page. Confirmed visual rejections: no gloss. No gradients, no glassmorphism, no glow, no drop shadows on content, no marketing-page energy.",
    "keyCharacteristics": [
      "Two reading grounds — Lampblack dark and Uncoated Cream paper — that share one token vocabulary and one accent hue.",
      "Antique Bronze as the only interactive colour; it marks state, it never fills a surface.",
      "Serif headings (Cormorant Garamond) over sans/serif-adjacent body text (Lexend for articles, Inter for interface), with Amiri as the Arabic fallback inside every stack.",
      "Mono uppercase marginalia at 12px for every label, index number and piece of metadata.",
      "Flat document, shadowed floaters: content sits on the page, only genuinely floating layers are lifted off it.",
      "1px rules and one-step tonal shifts instead of boxes and cards wherever either will do."
    ],
    "rules": [
      {
        "name": "The Bronze Minority Rule",
        "section": "colors",
        "body": "Bronze is a state colour, not a surface colour. If more than a few percent of a viewport is bronze, something is wrong: the accent earns its power by being the only saturated thing on the page."
      },
      {
        "name": "The Two-Script Rule",
        "section": "colors",
        "body": "Amiri sits in every font stack as the last resolvable face, so an Arabic glyph — or the ﷺ ligature — always lands on a Naskh face that matches the serif headings. Latin resolves in front of it and is unaffected."
      },
      {
        "name": "The Marginalia Rule",
        "section": "typography",
        "body": "Anything that is bookkeeping rather than content — a date, a reading time, a word count, a category, an index number, a button label — is set in uppercase mono at 12px in Faded Parchment. Anything that is content is set in Lexend. The two never mix inside one line except in the article meta row, where the mono labels sit under the serif title."
      },
      {
        "name": "The Measure Rule",
        "section": "layout",
        "body": "Article prose is capped at roughly 65 characters per line. Headers, meta rows, related-article grids and footers align to the prose column's left edge so the page reads as one margin."
      },
      {
        "name": "The Floating-Layer Rule",
        "section": "elevation",
        "body": "A shadow is only ever a declaration that a layer is above the document. Content that scrolls with the page never gets one."
      },
      {
        "name": "The Diamond Rule",
        "section": "shapes",
        "body": "The recurring mark of this system is a small square rotated 45° in Antique Bronze: it bullets list items, separates table-of-contents sub-headings, divides sections, and labels the article's summary block. New marks should be diamonds unless there is a reason not to be."
      }
    ],
    "dos": [
      "Do separate structure with a 1px Umber Rule before reaching for a border, a fill or a shadow.",
      "Do set metadata, labels, index numbers and button text in uppercase mono at 12px in Faded Parchment.",
      "Do use Antique Bronze only to mark state — current, hover, focus, selected — and keep it under a few percent of any viewport.",
      "Do keep article prose at 17.6px with 1.9 line-height inside a ~65ch measure.",
      "Do give every keyboard-reachable element the global focus ring (:focus-visible, 2px Antique Bronze, 2px offset).",
      "Do express elevation with the tonal step from ground to surface (#11100d → #1b1714).",
      "Do reuse the diamond mark for new bullets, dividers and status marks."
    ],
    "donts": [
      "Don't put a shadow on anything that scrolls with the page.",
      "Don't fill a card, callout or chip with colour at rest.",
      "Don't introduce a second saturated hue outside the six MDX callout inks.",
      "Don't add gradients, glassmorphism, glow or any other gloss.",
      "Don't set a sentence in uppercase mono, or metadata in the serif.",
      "Don't let Arabic fall through to a mismatched fallback — Amiri stays in the stack.",
      "Don't use a radius other than 8px for controls, or a pill for anything that is not a chip."
    ]
  }
}
