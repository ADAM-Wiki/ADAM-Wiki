{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://ADAM-Wiki.github.io/ADAM-Wiki/",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "git config core.longpaths true && gh-pages -d dist",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "generate:hadis-meta": "tsx scripts/generate-hadis-meta.ts",
    "generate:ateizam-meta": "tsx scripts/generate-ateizam-meta.ts",
    "generate:hriscanstvo-meta": "tsx scripts/generate-hriscanstvo-meta.ts",
    "generate:hinduizam-meta": "tsx scripts/generate-hinduizam-meta.ts",
    "generate:islam-meta": "tsx scripts/generate-islam-meta.ts",
    "generate:istorija-meta": "tsx scripts/generate-istorija-meta.ts",
    "generate:ahmedije-meta": "tsx scripts/generate-ahmedije-meta.ts",
    "generate:odgovori-meta": "tsx scripts/generate-odgovori-meta.ts",
    "generate:opovrgavanje-meta": "tsx scripts/generate-opovrgavanje-meta.ts",
    "generate:nauka-meta": "tsx scripts/generate-nauka-meta.ts",
    "generate:muhammed-meta": "tsx scripts/generate-muhammed-meta.ts",
    "generate:meta": "tsx scripts/generate-meta.ts",
    "check:search": "tsx scripts/check-search.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:og-image": "tsx scripts/generate-og-image.ts",
    "prerender": "tsx scripts/prerender.ts",
    "build": "npm run generate:meta && npm run generate:sitemap && vite build && npm run prerender"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.15.0",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "puppeteer": "^25.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
