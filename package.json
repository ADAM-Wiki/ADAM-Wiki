{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://ADAM-Wiki.github.io/ADAM-Wiki/",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "git config core.longpaths true && gh-pages -d dist",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "generate:meta": "tsx scripts/generate-meta.ts",
    "check:search": "tsx scripts/check-search.ts",
    "check:registry": "tsx scripts/check-registry.ts",
    "check:anchors": "tsx scripts/check-anchors.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:og-image": "tsx scripts/generate-og-image.ts",
    "generate:image-sizes": "tsx scripts/generate-image-sizes.ts",
    "images:webp": "tsx scripts/convert-to-webp.ts",
    "prerender": "tsx scripts/prerender.ts",
    "build": "npm run generate:meta && npm run check:registry && npm run check:anchors && npm run generate:og-image && npm run generate:image-sizes && npm run generate:sitemap && vite build && npm run prerender"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.15.0",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "puppeteer": "^25.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
